# =============================================================================
# Frontend Architecture — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# API Configuration
# ---------------------------------------------------------------------------

# Public API base URL (exposed to the browser via NEXT_PUBLIC_ prefix).
# Used by the SDK on the client side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Private API base URL (server-side only, never exposed to the browser).
# Used by Server Components, Server Actions, and Route Handlers.
# Falls back to NEXT_PUBLIC_API_BASE_URL if not set.
API_BASE_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Name of the CSRF cookie set by the backend (used for double-submit protection).
# Default: XSRF-TOKEN
# CSRF_COOKIE_NAME=XSRF-TOKEN

# ---------------------------------------------------------------------------
# Observability (Optional)
# ---------------------------------------------------------------------------

# Set to "true" to enable verbose request/response logging.
# NEXT_PUBLIC_API_DEBUG=false

# OpenTelemetry collector endpoint (optional, for distributed tracing).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
